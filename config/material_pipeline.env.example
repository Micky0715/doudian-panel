# Read-only Feishu Drive source. Share the material root folder with this app/bot.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MATERIAL_ROOT_FOLDER_TOKEN=

# Metadata only; this cache never contains Feishu/DouDian credentials or image bytes.
DP_MATERIAL_METADATA_CACHE=panel_data/material_metadata_cache

# Exact, read-only source layout. Folder names must equal the normalised brand
# and model key; no filename or neighbouring-model fuzzy match is allowed.
# White: 白底图库/手机/<brand>/<model>/白底图/白底图_01.jpg ... 白底图_04.jpg
# Main: 抖音主图/<shop_id>/<brand>/<model>/主图/主图.jpg
# If main folders will contain model directly below the shop, explicitly set:
# FEISHU_MAIN_PATH_LAYOUT=shop_model
# The Apple cloud directory is named Apple while the listing brand is 苹果.
# More explicit directory-name exceptions may be supplied as JSON:
# Current shared-library directory aliases (same identities as the local
# brand/model rules; override only when the operator-maintained folder differs):
# FEISHU_BRAND_FOLDER_MAP_JSON={"红米":"Redmi","苹果":"Apple"}
# A missing 主图 is allowed only when four valid, distinct white images remain;
# the first becomes the explicitly reported fallback main image.
